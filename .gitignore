openspec/

# ── 运维清理脚本（2026-10-27，暮雨：「退出仓库，不然纯污染」）──
# 这两个只用来清 desktop 下的历史产物目录，属本机一次性运维工具，不是产品代码。
# ⚠ 清理规则本身仍写在 AGENTS.md（只清 release*、永不碰 pkg、被锁的 asar 逐文件跳过）——
#   规则留在文档里，脚本留在本机。换机器时按 AGENTS 那几句重建即可。
clean-release.bat
scripts/clean-release-dirs.ps1
# 写侧留痕（2026-11-11）：与 mcp-usage.jsonl 同级的使用数据，不入库
.mcp-writes.jsonl
# ESLint 扫描产物（A1a 出账用，1.4MB，不入库）
.fe-lint.json

# 许可协议同意记录（2026-11-18）：每个数据根一份，不随仓库走
license_ack.json
