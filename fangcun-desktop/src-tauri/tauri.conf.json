{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/dev/.schema/config.schema.json",
  "productName": "方寸",
  "version": "0.1.0",
  "identifier": "com.muyu.fangcun",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:8753",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "方寸 tegula",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "python-backend"
    ],
    "resources": {
      "tegula.py": "./",
      "templates": "./templates",
      "registry-default.yaml": "./"
    }
  }
}
