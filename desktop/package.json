{
  "name": "fangcun-desktop",
  "version": "0.2.2",
  "description": "方寸 — 本地优先多 agent 任务地图",
  "main": "dist/index.js",
  "bin": {
    "tegula-mcp": "dist/cli/tegula-mcp.js"
  },
  "scripts": {
    "dev": "concurrently -k -n RENDERER,MAIN,ELECTRON -c magenta,cyan,yellow \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:electron": "node ../scripts/dev-electron-watch.cjs",
    "dev:electron:raw": "wait-on tcp:5173 dist/index.js && cross-env NODE_ENV=development electron .",
    "dev:debug": "concurrently -k -n RENDERER,MAIN,ELECTRON -c magenta,cyan,yellow \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron:debug\"",
    "dev:electron:debug": "cross-env OPEN_DEVTOOLS=1 node ../scripts/dev-electron-watch.cjs",
    "build": "node ../scripts/sync-public-tools.cjs && vite build && tsc -p tsconfig.main.json && tsc -p tsconfig.cli.json",
    "electron:build": "npm run build && electron-builder"
  },
  "keywords": [
    "kanban",
    "project-management",
    "electron"
  ],
  "author": "暮雨",
  "license": "MIT",
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "chokidar": "^3.6.0",
    "dompurify": "^3.4.15",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.4.2",
    "marked": "^18.0.9",
    "pinia": "^2.1.7",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.3",
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^8.2.0",
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.muyu.fangcun",
    "productName": "方寸",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": "public/fangcun-restore.py",
        "to": "tools/fangcun-restore.py"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "license": "LICENSE",
      "artifactName": "Fangcun-Setup.${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MUYU46548",
        "repo": "fangcun"
      }
    ]
  }
}
